<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>False</PublishAot>
    <OutputType>Exe</OutputType>
    <!-- Production runs windowless: a console window that someone clicks into QuickEdit "Select"
         blocks every Console.WriteLine, and with it every thread that logs. Without a console
         .NET routes Console output to a null stream. It can't be a Windows service instead:
         the JustRemotePhone SDK needs MSAdministrator's desktop session (PRODUCTION.md). -->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <PublishTrimmed>False</PublishTrimmed>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="BuildRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="Configuration=Release" />
  </Target>

  <!-- Stamp the git commit into InformationalVersion so a running build identifies itself
       (startup log + gateway-status). Reads .git files directly: no git binary needed. -->
  <Target Name="EmbedGitCommitHash" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;AddSourceRevisionToInformationalVersion" Condition="Exists('$(MSBuildProjectDirectory)/.git/HEAD')">
    <PropertyGroup>
      <_GitHead>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/.git/HEAD').Trim())</_GitHead>
    </PropertyGroup>
    <PropertyGroup Condition="$(_GitHead.StartsWith('ref: ')) And Exists('$(MSBuildProjectDirectory)/.git/$(_GitHead.Substring(5))')">
      <SourceRevisionId>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/.git/$(_GitHead.Substring(5))').Trim().Substring(0, 8))</SourceRevisionId>
    </PropertyGroup>
    <PropertyGroup Condition="!$(_GitHead.StartsWith('ref: '))">
      <SourceRevisionId>$(_GitHead.Substring(0, 8))</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- The test project lives under this directory; keep its files out of the default globs. -->
  <ItemGroup>
    <Compile Remove="SMS_Bridge.Tests/**" />
    <Content Remove="SMS_Bridge.Tests/**" />
    <None Remove="SMS_Bridge.Tests/**" />
  </ItemGroup>

  <!-- Ships with the release so reception's scheduled task can run it from the install directory. -->
  <ItemGroup>
    <None Update="Scripts\check-sms.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- JustRemotePhone's SDK: built against, never shipped. At run time Program.cs loads it from
       Call Centre's own install, so releases don't redistribute it. -->
  <ItemGroup>
    <Reference Include="RemotePhoneService">
      <HintPath>C:\Program Files (x86)\JustPhone\CallCenter\SDK\bin\RemotePhoneService.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
